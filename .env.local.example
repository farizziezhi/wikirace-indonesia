# Salin file ini menjadi `.env.local` lalu isi nilainya.
# .env.local tidak akan ter-commit (sudah di-ignore oleh .gitignore).

# Ably — dari dashboard https://ably.com/dashboard
# Hanya dipakai di server side (API Route). Jangan pernah expose ke client.
ABLY_API_KEY=

# Upstash Redis — dari dashboard https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Discord Webhook URL untuk notifikasi formulir kontak
DISCORD_CONTACT_WEBHOOK_URL=
